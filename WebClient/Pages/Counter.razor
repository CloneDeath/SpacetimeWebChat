@page "/counter"

<PageTitle>Web Chat</PageTitle>

<h1>Web Chat</h1>

@foreach (var message in Messages) {
    <div>
        @if (message.Sender != null) {
            <span>@message.Sender:</span>
            <span>@message.Text</span>
        } else {
            <span>@message.Text</span>
        }
    </div>
}

<input @bind="CurrentMessage" @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="Type a message..."/>
<button @onclick="SubmitMessage">Send</button>

@Length

@code {
    [Inject] public ServerApi ServerApi { get; set; } = null!;

    public List<ChatMessage> Messages { get; private set; } = [];

    public int Length = 0;

    private string CurrentMessage { get; set; } = "";

    private void HandleKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter") {
            SubmitMessage();
        }
    }

    private void SubmitMessage() {
        if (string.IsNullOrWhiteSpace(CurrentMessage)) return;
        SendMessage(CurrentMessage);
        CurrentMessage = string.Empty;
    }

    public void SendMessage(string message) {
        ServerApi.SendMessage(message);
        Messages = ServerApi.ChatMessages.ToList();
        Length = ServerApi.ChatMessages.Count;
    }
}